# Rust
/target/
**/*.rs.bk

# Node
node_modules/
dist/
*.log

# Benchmark result cache (regenerated by running the harness)
/viewer/results.json
*.tsbuildinfo

# Corpus cache: never commit downloaded third-party models.
# The fetcher refuses an in-repo cache, this is belt and braces.
/corpus-cache/
manifest.json
__pycache__/
*.pyc

# Probe build artefacts; the probe source itself is tracked.
/simd-probe/target/

# Probe crates keep their own target dirs.
perf-probe/target/
simd-probe/target/
